{
    "manifest_version": 3,
    "name": "PhishAlert",
    "version": "1.0",
    "description": "A real-time phishing detection and recovery Chrome extension.",
    "permissions": [
        "tabs",
        "storage",
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "128": "assets/icon.png"
        }
    },
    "background": {
        "service_worker": "background/background.js"
    },
"content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": [
      "ai/urlChecker.js",
      "ai/interfaceMatcher.js",
      "alerts/alertOverlay.js",
      "content/content.js"
    ],
    "run_at": "document_idle"
  }
]
,
    "icons": {
        "16": "assets/icon.png",
        "48": "assets/icon.png",
        "128": "assets/icon.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "alerts/alertTemplate.html",
                "assets/alert.mp3"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}